# A3S Code SDK 配置 - Kimi (OpenAI 兼容端点)
# 凭证通过环境变量在运行时注入。
# 通过 KIMI_API_KEY / KIMI_BASE_URL 环境变量设置连接凭证。

default_model = "openai/kimi-k2.5"

providers "openai" {
  api_key  = env("KIMI_API_KEY")
  base_url = env("KIMI_BASE_URL")

  models "kimi-k2.5" {
    name = "KIMI K2.5"
  }
}

storage_backend = "memory"
max_tool_rounds = 20
