# A3S Code Python SDK - Justfile

default:
    @just --list

# ============================================================================
# Setup
# ============================================================================

# Install dependencies
install:
    pip install -e ".[dev]"

# ============================================================================
# Build
# ============================================================================

# Build the package
build:
    python -m build

# Generate protobuf files
proto:
    python -m grpc_tools.protoc \
        -I./proto \
        --python_out=./a3s_code \
        --pyi_out=./a3s_code \
        --grpc_python_out=./a3s_code \
        ./proto/code_agent.proto

# Clean build artifacts
clean:
    rm -rf build dist *.egg-info
    rm -rf .pytest_cache .mypy_cache .ruff_cache
    rm -rf htmlcov .coverage coverage.xml
    find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find . -type f -name "*.pyc" -delete 2>/dev/null || true

# ============================================================================
# Test (unified command with progress display)
# ============================================================================

# Run all tests with progress display
test:
    #!/usr/bin/env bash
    set -e

    # Colors
    BOLD='\033[1m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    DIM='\033[2m'
    RESET='\033[0m'

    print_header() {
        echo ""
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${BOLD}  $1${RESET}"
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    }

    print_header "🧪 A3S Code Python SDK Test Suite"
    echo ""
    echo -ne "${CYAN}▶${RESET} ${BOLD}a3s-code${RESET} "

    # Run tests and capture output
    if OUTPUT=$(python -m pytest tests/ -v 2>&1); then
        TEST_EXIT=0
    else
        TEST_EXIT=1
    fi

    # Extract test results from pytest output
    PASSED=$(echo "$OUTPUT" | grep -oE '[0-9]+ passed' | grep -oE '[0-9]+' || echo "0")
    FAILED=$(echo "$OUTPUT" | grep -oE '[0-9]+ failed' | grep -oE '[0-9]+' || echo "0")

    if [ "$FAILED" -gt 0 ] || [ "$TEST_EXIT" -ne 0 ]; then
        echo -e "${RED}✗${RESET} ${DIM}$PASSED passed, $FAILED failed${RESET}"
        echo "$OUTPUT" | grep -E "FAILED|ERROR|AssertionError" | head -5 | sed 's/^/    /'
    else
        echo -e "${GREEN}✓${RESET} ${DIM}$PASSED passed${RESET}"
    fi

    # Summary
    echo ""
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"

    if [ "$FAILED" -gt 0 ] || [ "$TEST_EXIT" -ne 0 ]; then
        echo -e "  ${RED}${BOLD}✗ FAILED${RESET}  ${GREEN}$PASSED passed${RESET}  ${RED}$FAILED failed${RESET}"
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        exit 1
    else
        echo -e "  ${GREEN}${BOLD}✓ PASSED${RESET}  ${GREEN}$PASSED passed${RESET}"
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    fi
    echo ""

# Run tests without progress (raw output)
test-raw:
    python -m pytest tests/ -v

# Run tests in verbose mode with output
test-v:
    python -m pytest tests/ -v -s

# ============================================================================
# Coverage
# ============================================================================

# Run tests with coverage report
test-cov:
    #!/usr/bin/env bash
    set -e

    # Colors
    BOLD='\033[1m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    YELLOW='\033[0;33m'
    RED='\033[0;31m'
    DIM='\033[2m'
    RESET='\033[0m'

    print_header() {
        echo ""
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "${BOLD}  $1${RESET}"
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    }

    print_header "🧪 A3S Code Python SDK Test Suite with Coverage"
    echo ""

    # Run tests with coverage
    python -m pytest tests/ -v --cov=a3s_code --cov-report=term-missing

    echo ""
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

# Coverage with HTML report (opens in browser)
cov-html:
    python -m pytest tests/ --cov=a3s_code --cov-report=html && open htmlcov/index.html

# Coverage for CI (generates coverage.xml)
cov-ci:
    python -m pytest tests/ --cov=a3s_code --cov-report=xml

# ============================================================================
# Code Quality
# ============================================================================

# Type check with mypy
check:
    mypy a3s_code

# Lint with ruff
lint:
    ruff check a3s_code tests

# Format with ruff
fmt:
    ruff format a3s_code tests

# Fix linting issues
fix:
    ruff check --fix a3s_code tests

# CI checks (lint + check + test)
ci: lint check test

# ============================================================================
# Publish
# ============================================================================

# Publish to PyPI (with all checks)
publish:
    #!/usr/bin/env bash
    set -e

    # Colors
    BOLD='\033[1m'
    GREEN='\033[0;32m'
    BLUE='\033[0;34m'
    RED='\033[0;31m'
    DIM='\033[2m'
    RESET='\033[0m'

    print_step() {
        echo -e "${BLUE}▶${RESET} ${BOLD}$1${RESET}"
    }

    print_success() {
        echo -e "${GREEN}✓${RESET} $1"
    }

    print_error() {
        echo -e "${RED}✗${RESET} $1"
        exit 1
    }

    echo ""
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo -e "${BOLD}  📦 Publishing a3s-code to PyPI${RESET}"
    echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    echo ""

    # Show current version
    VERSION=$(python -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['version'])")
    echo -e "  ${DIM}Version:${RESET} ${BOLD}${VERSION}${RESET}"
    echo ""

    # Step 1: Lint
    print_step "Running linter..."
    if ruff check a3s_code tests; then
        print_success "Lint OK"
    else
        print_error "Lint check failed."
    fi

    # Step 2: Type check
    print_step "Type checking..."
    if mypy a3s_code; then
        print_success "Type check OK"
    else
        print_error "Type check failed."
    fi

    # Step 3: Test
    print_step "Running tests..."
    if python -m pytest tests/ -v; then
        print_success "Tests OK"
    else
        print_error "Tests failed."
    fi

    # Step 4: Build
    print_step "Building..."
    rm -rf dist/
    if python -m build; then
        print_success "Build OK"
    else
        print_error "Build failed."
    fi

    # Step 5: Publish
    print_step "Publishing to PyPI..."
    if python -m twine upload dist/*; then
        echo ""
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
        echo -e "  ${GREEN}${BOLD}✓ Successfully published a3s-code v${VERSION}${RESET}"
        echo -e "${BOLD}${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${RESET}"
    else
        print_error "Publish failed."
    fi
    echo ""

# Publish dry-run (verify without publishing)
publish-dry:
    #!/usr/bin/env bash
    set -e
    echo ""
    echo "┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓"
    echo "┃                    📦 Publish Dry Run (a3s-code)                        ┃"
    echo "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
    echo ""
    VERSION=$(python -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['version'])")
    echo "Version: ${VERSION}"
    echo ""
    rm -rf dist/
    python -m build
    echo ""
    echo "Built packages:"
    ls -la dist/
    echo ""
    echo "✓ Dry run successful. Ready to publish with 'just publish'"
    echo ""

# Show current version
version:
    @python -c "import tomllib; print(tomllib.load(open('pyproject.toml', 'rb'))['project']['version'])"

# ============================================================================
# Utilities
# ============================================================================

# Run all checks (lint, type check, test)
all: lint check test
