# This target currently requires macOS. Other host profiles fail discovery
# explicitly until their actual-TUI qualification is implemented. Positive
# coding cases stay in the same gate as refusal recovery and read cases.
suite "tui_913_real_llm" {
  package = "a3s-code-acp"
  track = "mandatory"
  features = ["a3s-code-core/deep-live", "a3s-code-core/advanced-harness"]
  minimum_tests = 10
}
